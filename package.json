{
  "name": "shoutkit",
  "version": "2.0.0",
  "description": "ShoutKit browser extension: search and play internet radio from Radio Browser. No accounts, no tracking.",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "webpack --mode=production",
    "build:dev": "webpack --mode=development",
    "build:watch": "webpack --mode=development --watch",
    "test": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./test/register.mjs\" mocha test/**/*.mjs",
    "test:watch": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./test/register.mjs\" mocha test/**/*.mjs --watch",
    "lint": "eslint app/**/*.ts",
    "lint:fix": "eslint app/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf app/dist node_modules",
    "format": "prettier --write \"**/*.{js,ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,json,md}\"",
    "pre-commit": "npm run format && npm run lint && npm run type-check && npm test",
    "package": "npm run build && npm run test && cd app && zip -r ../shoutkit.zip . -x '*.ts' '*.map' 'scripts/*.ts' 'manifest.firefox.json'",
    "dev": "npm run build:dev && npm run type-check",
    "validate-setup": "bash tools/validate-setup.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "chai": "6.3.0",
    "chrome-types": "^0.1.464",
    "eslint": "^10.15.0",
    "minimist": "1.2.8",
    "mocha": "12.0.3",
    "prettier": "^3.10.1",
    "serialize-javascript": "7.1.4",
    "sinon": "^22.1.0",
    "sinon-chrome": "3.0.1",
    "ts-loader": "9.6.2",
    "typescript": "^5.9.3",
    "webpack": "5.112.2",
    "webpack-cli": "7.3.1"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "minimatch": "^11.0.4"
  },
  "resolutions": {
    "lodash": "^4.18.1",
    "minimatch": "^11.0.4"
  },
  "keywords": [
    "chrome-extension",
    "firefox-extension",
    "shoutkit",
    "internet-radio",
    "radio-browser"
  ],
  "author": "Kevin Coughlin",
  "license": "MIT",
  "homepage": "https://github.com/cascadiacollections/shoutkit-browser-extension",
  "repository": {
    "type": "git",
    "url": "https://github.com/cascadiacollections/shoutkit-browser-extension.git"
  },
  "bugs": {
    "url": "https://github.com/cascadiacollections/shoutkit-browser-extension/issues"
  }
}
